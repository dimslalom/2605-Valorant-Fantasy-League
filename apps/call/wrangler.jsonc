{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "opval",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,

  "observability": { "enabled": true },

  "routes": [{ "pattern": "opval.dimas.works", "custom_domain": true }],

  // Static files are served straight from assets. Only HTML routes and the API run the
  // Worker, so card art and bundles do not count as Worker invocations.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/*", "!/assets/*", "!/favicon.svg"],
    "not_found_handling": "none"
  },

  // Same database as the old site: the feed job writes matches there, this app reads them.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vfl-daily-scores",
      "database_id": "8bfc8861-0417-46d8-8bd5-e18ef206503b",
      "migrations_dir": "../../migrations"
    }
  ],

  "vars": { "FEED_STALE_MINUTES": "120", "FEED_ATTRIBUTION": "Data: vlr.gg" }
}
