<Rive version="1" kind="fragment">
    <!-- FixtureCard: one match on the board. 160x96, a component repeated by FixtureStrip.
         Draw order: FIRST sibling is in FRONT, so overlays and text come before the plate. -->
    <Artboard x="400" y="0" isComponent="true" styleId="3:5" viewModelId="1:70" viewModelInstanceId="1:90"
              width="160" height="96" name="FixtureCard" id="3:2">
        <LayoutComponentStyle layoutWidthScaleType="fixed" layoutHeightScaleType="fixed" name="Card Style" id="3:5"/>

        <!-- favourite overlays: teal copies of the tags, opacity driven by homeFav / awayFav -->
        <Text x="14" y="26" sizingValue="autoWidth" originX="0" originY="0.5" name="HomeFav" id="3:10">
            <DataBindContext sourcePathIds="1:70-1:76" propertyKey="18"/>
            <TextStylePaint fontSize="22" fontAssetId="1:60" name="HomeFavStyle" id="3:11">
                <Fill name="Fill"><SolidColor colorValue="FF00C8A0" name="C"/></Fill>
            </TextStylePaint>
            <TextValueRun styleId="3:11" text="TL" name="Run">
                <DataBindContext sourcePathIds="1:70-1:71" propertyKey="268"/>
            </TextValueRun>
        </Text>
        <Text x="146" y="26" sizingValue="autoWidth" originX="1" originY="0.5" name="AwayFav" id="3:12">
            <DataBindContext sourcePathIds="1:70-1:77" propertyKey="18"/>
            <TextStylePaint fontSize="22" fontAssetId="1:60" name="AwayFavStyle" id="3:13">
                <Fill name="Fill"><SolidColor colorValue="FF00C8A0" name="C"/></Fill>
            </TextStylePaint>
            <TextValueRun styleId="3:13" text="PRX" name="Run">
                <DataBindContext sourcePathIds="1:70-1:72" propertyKey="268"/>
            </TextValueRun>
        </Text>

        <!-- "N OF YOURS" stamp and accent bar: opacity = mine (0/1) -->
        <Text x="80" y="82" sizingValue="autoWidth" originX="0.5" originY="0.5" name="MineText" id="3:14">
            <DataBindContext sourcePathIds="1:70-1:78" propertyKey="18"/>
            <TextStylePaint fontSize="10" fontAssetId="1:60" name="MineStyle" id="3:15">
                <Fill name="Fill"><SolidColor colorValue="FFFFFFFF" name="C"/></Fill>
            </TextStylePaint>
            <TextValueRun styleId="3:15" text="1 OF YOURS" name="Run">
                <DataBindContext sourcePathIds="1:70-1:75" propertyKey="268"/>
            </TextValueRun>
        </Text>
        <Shape x="80" y="82" name="MineStamp" id="3:16">
            <DataBindContext sourcePathIds="1:70-1:78" propertyKey="18"/>
            <Rectangle width="144" height="16" name="Path"/>
            <Fill name="Fill"><SolidColor colorValue="FFFF4655" name="C"/></Fill>
        </Shape>
        <Shape x="1.5" y="48" name="MineBar" id="3:17">
            <DataBindContext sourcePathIds="1:70-1:78" propertyKey="18"/>
            <Rectangle width="3" height="96" name="Path"/>
            <Fill name="Fill"><SolidColor colorValue="FFFF4655" name="C"/></Fill>
        </Shape>

        <!-- base text (muted) -->
        <Text x="80" y="26" sizingValue="autoWidth" originX="0.5" originY="0.5" name="Vs" id="3:18">
            <TextStylePaint fontSize="10" fontAssetId="1:60" name="VsStyle" id="3:19">
                <Fill name="Fill"><SolidColor colorValue="FF8A8F9E" name="C"/></Fill>
            </TextStylePaint>
            <TextValueRun styleId="3:19" text="VS" name="Run"/>
        </Text>
        <Text x="14" y="26" sizingValue="autoWidth" originX="0" originY="0.5" name="HomeBase" id="3:20">
            <TextStylePaint fontSize="22" fontAssetId="1:60" name="HomeBaseStyle" id="3:21">
                <Fill name="Fill"><SolidColor colorValue="FF8A8F9E" name="C"/></Fill>
            </TextStylePaint>
            <TextValueRun styleId="3:21" text="TL" name="Run">
                <DataBindContext sourcePathIds="1:70-1:71" propertyKey="268"/>
            </TextValueRun>
        </Text>
        <Text x="146" y="26" sizingValue="autoWidth" originX="1" originY="0.5" name="AwayBase" id="3:22">
            <TextStylePaint fontSize="22" fontAssetId="1:60" name="AwayBaseStyle" id="3:23">
                <Fill name="Fill"><SolidColor colorValue="FF8A8F9E" name="C"/></Fill>
            </TextStylePaint>
            <TextValueRun styleId="3:23" text="PRX" name="Run">
                <DataBindContext sourcePathIds="1:70-1:72" propertyKey="268"/>
            </TextValueRun>
        </Text>
        <Text x="14" y="54" sizingValue="autoWidth" originX="0" originY="0.5" name="Strength" id="3:24">
            <TextStylePaint fontSize="10" fontAssetId="1:60" name="StrengthStyle" id="3:25">
                <Fill name="Fill"><SolidColor colorValue="FF8A8F9E" name="C"/></Fill>
            </TextStylePaint>
            <TextValueRun styleId="3:25" text="STRENGTH 28  33" name="Run">
                <DataBindContext sourcePathIds="1:70-1:73" propertyKey="268"/>
            </TextValueRun>
        </Text>
        <Text x="14" y="68" sizingValue="autoWidth" originX="0" originY="0.5" name="BestOf" id="3:26">
            <TextStylePaint fontSize="10" fontAssetId="1:60" name="BestOfStyle" id="3:27">
                <Fill name="Fill"><SolidColor colorValue="FF8A8F9E" name="C"/></Fill>
            </TextStylePaint>
            <TextValueRun styleId="3:27" text="BO3" name="Run">
                <DataBindContext sourcePathIds="1:70-1:74" propertyKey="268"/>
            </TextValueRun>
        </Text>

        <!-- plate: surface #161B29, last so it is at the back -->
        <Shape x="80" y="48" name="Plate" id="3:30">
            <Rectangle width="160" height="96" name="Path"/>
            <Fill name="Fill"><SolidColor colorValue="FF161B29" name="C"/></Fill>
        </Shape>

        <StateMachine name="Main" id="3:7">
            <StateMachineLayer name="Layer 1" id="3:8">
                <AnyState x="200" y="-120"/>
                <ExitState x="400" y="-120"/>
                <EntryState>
                    <StateTransition stateToId="3:41"/>
                </EntryState>
                <AnimationState x="200" animationId="3:40" id="3:41"/>
            </StateMachineLayer>
        </StateMachine>
        <LinearAnimation duration="60" name="Idle" id="3:40"/>
    </Artboard>
    <ComponentAsset artboardId="3:2" name="FixtureCard"/>
</Rive>
