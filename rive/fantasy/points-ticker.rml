<Rive version="1" kind="fragment">
    <!-- PointsTicker: the broadcast's big running total. 343x112. The number counts up
         inside Rive (interpolator, 0.9s) whenever the app sets a new total, and a delta
         stamp ("+31") fades in beside it. Front-to-back: stamp, number, label, plate. -->
    <Artboard defaultStateMachineId="5:7" styleId="5:5" viewModelId="1:120" viewModelInstanceId="1:121"
              x="760" y="200" width="343" height="112" name="PointsTicker" id="5:2">
        <LayoutComponentStyle name="Artboard Style" id="5:5"/>

        <!-- delta stamp: opacity = deltaShown, eased by FadeIn -->
        <Text x="327" y="52" sizingValue="autoWidth" originX="1" originY="0.5" name="Delta" id="5:10">
            <DataBindContext sourcePathIds="1:120-1:125" propertyKey="18" converterId="1:134"/>
            <TextStylePaint fontSize="28" fontAssetId="1:60" name="DeltaStyle" id="5:11">
                <Fill name="Fill"><SolidColor colorValue="FF00C8A0" name="C"/></Fill>
            </TextStylePaint>
            <TextValueRun styleId="5:11" text="+31" name="Run">
                <DataBindContext sourcePathIds="1:120-1:124" propertyKey="268"/>
            </TextValueRun>
        </Text>

        <!-- running total: accent #FF4655, tabular feel from the large size -->
        <Text x="16" y="52" sizingValue="autoWidth" originX="0" originY="0.5" name="Total" id="5:12">
            <TextStylePaint fontSize="72" fontAssetId="1:60" name="TotalStyle" id="5:13">
                <Fill name="Fill"><SolidColor colorValue="FFFF4655" name="C"/></Fill>
            </TextStylePaint>
            <TextValueRun styleId="5:13" text="44" name="Run">
                <DataBindContext sourcePathIds="1:120-1:122" propertyKey="268" converterId="1:133"/>
            </TextValueRun>
        </Text>

        <Text x="16" y="100" sizingValue="autoWidth" originX="0" originY="0.5" name="Label" id="5:14">
            <TextStylePaint fontSize="10" fontAssetId="1:60" name="LabelStyle" id="5:15">
                <Fill name="Fill"><SolidColor colorValue="FF8A8F9E" name="C"/></Fill>
            </TextStylePaint>
            <TextValueRun styleId="5:15" text="YOUR POINTS TODAY" name="Run">
                <DataBindContext sourcePathIds="1:120-1:123" propertyKey="268"/>
            </TextValueRun>
        </Text>

        <Shape x="171.5" y="56" name="Plate" id="5:20">
            <Rectangle width="343" height="112" name="Path"/>
            <Fill name="Fill"><SolidColor colorValue="FF161B29" name="C"/></Fill>
        </Shape>

        <StateMachine name="Main" id="5:7">
            <StateMachineLayer name="Layer 1" id="5:8">
                <AnyState x="200" y="-120"/>
                <ExitState x="400" y="-120"/>
                <EntryState>
                    <StateTransition stateToId="5:31"/>
                </EntryState>
                <AnimationState x="200" animationId="5:30" id="5:31"/>
            </StateMachineLayer>
        </StateMachine>
        <LinearAnimation duration="60" name="Idle" id="5:30"/>
    </Artboard>
</Rive>
