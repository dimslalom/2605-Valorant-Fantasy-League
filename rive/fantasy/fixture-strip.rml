<Rive version="1" kind="fragment">
    <!-- FixtureStrip: the day's matches, one FixtureCard per list item, in a row.
         Fit.Layout makes this artboard the size of its canvas, so the app sets the canvas
         width to cards * 168 and the DOM scrolls it on small screens. -->
    <Artboard x="0" y="200" defaultStateMachineId="4:7" styleId="4:5" viewModelId="1:100" viewModelInstanceId="1:101"
              width="720" height="96" name="FixtureStrip" id="4:2">
        <LayoutComponentStyle name="Artboard Style" id="4:5"/>
        <LayoutComponent width="720" height="96" styleId="4:11" name="Row" id="4:10">
            <LayoutComponentStyle flexDirectionValue="row" gapHorizontal="8" gapHorizontalUnitsValue="points"
                                  layoutWidthScaleType="fill" layoutHeightScaleType="fill" name="Row Style" id="4:11"/>
            <ArtboardComponentList name="Cards" id="4:12">
                <DataBindContext sourcePathIds="1:100-1:102" propertyKey="800"/>
            </ArtboardComponentList>
        </LayoutComponent>

        <StateMachine name="Main" id="4:7">
            <StateMachineLayer name="Layer 1" id="4:8">
                <AnyState x="200" y="-120"/>
                <ExitState x="400" y="-120"/>
                <EntryState>
                    <StateTransition stateToId="4:21"/>
                </EntryState>
                <AnimationState x="200" animationId="4:20" id="4:21"/>
            </StateMachineLayer>
        </StateMachine>
        <LinearAnimation duration="60" name="Idle" id="4:20"/>
    </Artboard>
</Rive>
