{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vct-lock-in",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,

  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  },

  "routes": [
    {
      "pattern": "vctfantasy.dimas.works",
      "custom_domain": true
    }
  ],

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none"
  },

  "durable_objects": {
    "bindings": [
      {
        "name": "LOBBIES",
        "class_name": "Lobby"
      }
    ]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vfl-daily-scores",
      "database_id": "8bfc8861-0417-46d8-8bd5-e18ef206503b",
      "migrations_dir": "migrations"
    }
  ],

  // Feed: raw stats live in the existing D1 (migrations/0002_feed.sql, applied by deploy.yml).
  // Ingest bearer is a secret, never committed: npx wrangler secret put FEED_INGEST_TOKEN
  "vars": { "FEED_STALE_MINUTES": "120", "FEED_ATTRIBUTION": "Data: vlr.gg" },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Lobby"]
    }
  ]
}
